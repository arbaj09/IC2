<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="recipientProfitCenterPicklist"
        title="Select Recipient Profit Center"
        search="onRecipientProfitCenterPicklistSearch"
        confirm="onRecipientProfitCenterPicklistConfirm"
        cancel="onRecipientProfitCenterPicklistCancel"
        noDataText="No Profit Centers found."
        growing="true"
        growingThreshold="50"
        items="{
            path: '/referenceData/profitCenters',
            templateShareable: false
        }">

        <StandardListItem
            title="{profitCenter}"
            description="{description}"
            info="{companyCode}"
            icon="sap-icon://accounting-document"
            iconInset="false" />

    </SelectDialog>

</core:FragmentDefinition>