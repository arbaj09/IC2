<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <l:Grid 
        id="gridDocDetails"
        defaultSpan="L4 M4 S12" 
        hSpacing="2" 
        vSpacing="1"
        class="sapUiSmallMarginTopBottom">
        <l:content>

            <VBox id="vboxDocDate">
                <Label text="Document Date" required="true" class="sapUiTinyMarginBottom"/>
                <DatePicker
                    id="dpDocDate"
                    value="{/headerData/documentDate}"
                    displayFormat="dd.MM.yyyy"
                    valueFormat="dd.MM.yyyy"
                    placeholder="dd.MM.yyyy"
                    change="onDocumentDateChange"
                    editable="{/appState/isHeaderEditable}"
                    width="180px"
                    valueState="{/headerData/documentDateState}"
                    valueStateText="Document Date is required."/>
            </VBox>

            <VBox id="vboxPostingDate">
                <Label text="Posting Date" required="true" class="sapUiTinyMarginBottom"/>
                <DatePicker
                    id="dpPostingDate"
                    value="{/headerData/postingDate}"
                    displayFormat="dd.MM.yyyy"
                    valueFormat="dd.MM.yyyy"
                    placeholder="dd.MM.yyyy"
                    change="onPostingDateChange"
                    editable="{/appState/isHeaderEditable}"
                    width="180px"
                    valueState="{/headerData/postingDateState}"
                    valueStateText="Posting Date is required."/>
            </VBox>

            <VBox id="vboxFiscalPeriod">
                <Label text="Fiscal Period / Year" class="sapUiTinyMarginBottom"/>
                <Text 
                    id="txtFiscalPeriod"
                    text="{parts: [{path: '/headerData/fiscalPeriod'}, {path: '/headerData/fiscalYear'}], formatter: '.formatter.fiscalPeriodText'}"
                    renderWhitespace="false"/>
            </VBox>

            <VBox id="vboxPeriodStatus">
                <Label text="Period Status" class="sapUiTinyMarginBottom"/>
                <ObjectStatus 
                    id="stPeriodStatus"
                    text="{/headerData/periodStatusText}"
                    state="{/headerData/periodStatusState}"
                    icon="{/headerData/periodStatusIcon}"/>
            </VBox>

            <VBox id="vboxReference">
                <Label text="Reference" required="true" class="sapUiTinyMarginBottom"/>
                <Input
                    id="inpReference"
                    value="{/headerData/reference}"
                    maxLength="18"
                    placeholder="Up to 18 chars (BKPF-XBLNR)"
                    editable="{/appState/isHeaderEditable}"
                    width="240px"
                    change="onReferenceChange"
                    valueState="{/headerData/referenceState}"
                    valueStateText="Reference is required."/>
            </VBox>

            <VBox id="vboxHeaderText">
                <Label text="Header Text" required="true" class="sapUiTinyMarginBottom"/>
                <Input
                    id="inpHeaderText"
                    value="{/headerData/headerText}"
                    maxLength="50"
                    placeholder="Up to 50 chars"
                    editable="{/appState/isHeaderEditable}"
                    width="240px"
                    change="onHeaderTextChange"
                    valueState="{/headerData/headerTextState}"
                    valueStateText="Header Text is required."/>
            </VBox>

            <VBox id="vboxCurrency">
                <Label text="Currency" required="true" class="sapUiTinyMarginBottom"/>
                <Select
                    id="selCurrency"
                    selectedKey="{/headerData/currency}"
                    enabled="{/appState/isHeaderEditable}"
                    width="120px">
                    <core:Item key="USD" text="USD"/>
                    <core:Item key="EUR" text="EUR"/>
                    <core:Item key="GBP" text="GBP"/>
                    <core:Item key="ZAR" text="ZAR"/>
                    <core:Item key="KES" text="KES"/>
                    <core:Item key="NGN" text="NGN"/>
                    <core:Item key="GHS" text="GHS"/>
                </Select>
            </VBox>

            <!-- 1. Intercompany Net Amount -->
            <VBox id="vboxNetAmount">
                <Label text="IC Net Amount" required="true" class="sapUiTinyMarginBottom"/>
                <Input
                    id="inpNetAmount"
                    value="{/headerData/netAmount}"
                    type="Number"
                    placeholder="0.00"
                    textAlign="End"
                    liveChange="onIntercoAmountChange"
                    change="onIntercoAmountChange"
                    editable="{/appState/isHeaderEditable}"
                    width="200px"
                    valueState="{/headerData/netAmountState}"
                    valueStateText="IC Net Amount must be greater than zero."/>
            </VBox>

            <!-- 2. Tax Amount -->
            <VBox id="vboxTaxAmount">
                <Label text="Tax Amount" class="sapUiTinyMarginBottom"/>
                <Input
                    id="inpTaxAmount"
                    value="{/headerData/taxAmount}"
                    type="Number"
                    placeholder="0.00"
                    textAlign="End"
                    liveChange="onIntercoAmountChange"
                    change="onIntercoAmountChange"
                    editable="{/appState/isHeaderEditable}"
                    width="200px"/>
            </VBox>

            <!-- 3. Total Intercompany Amount (Calculated: Net + Tax) -->
            <VBox id="vboxTotalAmount">
                <Label text="Total IC Amount" class="sapUiTinyMarginBottom"/>
                <Input 
                    id="inpTotalAmount"
                    value="{/headerData/totalIntercoAmount}"
                    type="Number" 
                    textAlign="End"
                    editable="false" 
                    width="200px"/>
            </VBox>

        </l:content>
    </l:Grid>


</core:FragmentDefinition>