<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="docTypePicklistDialog"
        title="Select Document Type"
        noDataText="No document types found."
        search="onDocTypePicklistSearch"
        confirm="onDocTypePicklistConfirm"
        cancel="onDocTypePicklistCancel"
        growing="true"
        growingThreshold="50"
        items="{
            path: '/referenceData/documentTypes',
            templateShareable: false
        }">

        <StandardListItem
            title="{documentType}"
            description="{description}"
            iconInset="false"/>

    </SelectDialog>

</core:FragmentDefinition>
