<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="recipientGLAccountPicklist"
        title="Select Recipient GL Account"
        search="onRecipientGLAccountPicklistSearch"
        confirm="onRecipientGLAccountPicklistConfirm"
        cancel="onRecipientGLAccountPicklistCancel"
        noDataText="No GL Accounts found."
        items="{
            path: '/referenceData/glAccounts',
            templateShareable: false
        }">

        <StandardListItem
            title="{GLAccount}"
            description="{GLAccountName}"
            info="{CompanyCode}" />

    </SelectDialog>

</core:FragmentDefinition>