<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="recipientPreparerDialog"
        title="Select Recipient Preparer"
        contentWidth="44rem"
        contentHeight="28rem"
        draggable="true"
        resizable="true"
        stretch="{device>/system/phone}">

        <subHeader>
            <Toolbar>
                <SearchField
                    id="recipientPreparerSearchField"
                    width="100%"
                    placeholder="Search by business partner, user ID, name..."
                    search=".onRecipientPreparerFilter"
                    liveChange=".onRecipientPreparerFilter"/>
            </Toolbar>
        </subHeader>

        <content>
            <Table
                id="recipientPreparerTable"
                noDataText="No records found."
                growing="true"
                growingThreshold="50"
                items="{
                    path: '/referenceData/recipientPreparerVHData',
                    templateShareable: false
                }">

                <columns>
                    <Column width="30%">
                        <Text text="Business Partner"/>
                    </Column>
                    <Column width="30%">
                        <Text text="User ID"/>
                    </Column>
                    <Column width="40%">
                        <Text text="Name"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="Active"
                        press=".onRecipientPreparerSelect">
                        <cells>
                            <Text text="{BusinessPartner}"/>
                            <Text text="{UserID}"/>
                            <Text text="{PersonFullName}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>

        <endButton>
            <Button
                text="Cancel"
                press=".onRecipientPreparerCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
