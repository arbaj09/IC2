<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <TableSelectDialog
        id="recipientProfitCenterPicklist"
        title="Select Recipient Profit Center"
        search="onRecipientProfitCenterPicklistSearch"
        confirm="onRecipientProfitCenterPicklistConfirm"
        cancel="onRecipientProfitCenterPicklistCancel"
        noDataText="No Profit Centers found."
        growing="true"
        growingThreshold="50"
        items="{
            path: '/referenceData/profitCenters',
            templateShareable: false
        }">
        <columns>
            <Column width="25%"><Label text="profitCenter"/></Column>
            <Column width="40%"><Label text="ProfitCenter_Text"/></Column>
            <Column width="15%"><Label text="Company Code"/></Column>
            <Column width="15%"><Label text="ControllingArea"/></Column>
            <Column width="20%"><Label text="ValidityStartDate"/></Column>
             <Column width="20%"><Label text="ValidityEndDate"/></Column>
        </columns>

        <ColumnListItem type="Active">
            <cells>
                <Text text="{profitCenter}"/>
                <Text text="{description}"/>
                <Text text="{companyCode}"/>
                 <Text text="{ControllingArea}"/>
                <Text text="{ValidityStartDate}"/>
                 <Text text="{ValidityEndDate}"/>
               
            </cells>
        </ColumnListItem>

    </TableSelectDialog>

</core:FragmentDefinition>