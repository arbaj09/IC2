<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <TableSelectDialog
        id="glAccountPicklist"
        title="Select: G/L Account"
        search="onGLAccountPicklistSearch"
        confirm="onGLAccountPicklistConfirm"
        cancel="onGLAccountPicklistCancel"
        noDataText="No GL Accounts found."
        growing="true"
        growingThreshold="50"
        items="{
            path: '/referenceData/glAccounts',
            templateShareable: false
        }">

        <columns>
            <Column width="25%"><Label text="G/L Account"/></Column>
            <Column width="40%"><Label text="G/L Account Name"/></Column>
            <Column width="15%"><Label text="Company Code"/></Column>
            <Column width="20%"><Label text="Chart of Accounts"/></Column>
             <Column width="20%"><Label text="GLAccountLongName"/></Column>
        </columns>

        <ColumnListItem type="Active">
            <cells>
                <Text text="{GLAccount}"/>
                <Text text="{GLAccountName}"/>
                <Text text="{CompanyCode}"/>
                <Text text="{ChartOfAccounts}"/>
                 <Text text="{GLAccountLongName}"/>
               
            </cells>
        </ColumnListItem>

    </TableSelectDialog>

</core:FragmentDefinition>