<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="recipientCostCenterPicklist"
        title="Select Recipient Cost Center"
        contentWidth="40rem"
        contentHeight="25rem"
        draggable="true"
        resizable="true">

        <subHeader>
            <Toolbar>
                <SearchField
                    width="100%"
                    placeholder="Search Cost Center..."
                    search="onRecipientCostCenterPicklistSearch"
                    liveChange="onRecipientCostCenterPicklistSearch"/>
            </Toolbar>
        </subHeader>

        <content>
            <Table
                noDataText="No Cost Centers found."
                growing="true"
                growingThreshold="50"
                items="{
                    path: '/referenceData/costCenters',
                    templateShareable: false
                }">

                <columns>

                    <Column width="35%">
                        <Text text="Cost Center"/>
                    </Column>

                    <Column width="45%">
                        <Text text="Description"/>
                    </Column>

                    <Column width="20%">
                        <Text text="Company Code"/>
                    </Column>

                </columns>

                <items>

                    <ColumnListItem type="Active">

                        <cells>

                            <Text text="{CostCenter}"/>

                            <Text text="{CostCenter_Text}"/>

                            <Text text="{CompanyCode}"/>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>
        </content>

        <endButton>

            <Button
                text="Cancel"
                press="onRecipientCostCenterPicklistCancel"/>

        </endButton>

    </Dialog>

</core:FragmentDefinition>