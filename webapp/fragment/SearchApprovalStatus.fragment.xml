<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="searchApprovalStatusDialog"
        title="Select Approval Status"
        contentWidth="32rem"
        contentHeight="28rem"
        draggable="true"
        resizable="true"
        stretch="{device>/system/phone}">

        <subHeader>
            <Toolbar>
                <SearchField
                    id="searchApprovalStatusSearchField"
                    width="100%"
                    placeholder="Search by status..."
                    search=".onSearchApprovalStatusFilter"
                    liveChange=".onSearchApprovalStatusFilter"/>
            </Toolbar>
        </subHeader>

        <content>
            <Table
                id="searchApprovalStatusTable"
                mode="MultiSelect"
                noDataText="No records found."
                growing="true"
                growingThreshold="50"
                items="{
                    path: '/referenceData/approvalStatusVHData',
                    templateShareable: false
                }">

                <columns>
                    <Column width="30%">
                        <Text text="Code"/>
                    </Column>
                    <Column width="70%">
                        <Text text="Status"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{AprCode}"/>
                            <Text text="{Text}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>

        <beginButton>
            <Button
                text="OK"
                type="Emphasized"
                press=".onSearchApprovalStatusConfirm"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onSearchApprovalStatusCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
