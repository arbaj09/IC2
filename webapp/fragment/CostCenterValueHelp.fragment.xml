<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <SelectDialog
        id="costCenterPicklist"
        title="Select Cost Center"
        search="onCostCenterPicklistSearch"
        confirm="onCostCenterPicklistConfirm"
        cancel="onCostCenterPicklistCancel"
        noDataText="No Cost Centers found."
        items="{
            path: '/referenceData/costCenters',
            templateShareable: false
        }">

        <StandardListItem
            title="{CostCenter}"
            description="{CostCenter_Text}"
            info="{CompanyCode}" />

    </SelectDialog>

</core:FragmentDefinition>